<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2B2B2B"
    tools:context=".views.activity_dashboard">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ComuniEventos"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu comunidad, tus eventos"
                android:textColor="#CFCFCF"
                android:textSize="15sp"
                android:layout_marginBottom="28dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Qué deseas hacer?"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="1"
                android:useDefaultMargins="true">

                <Button
                    android:id="@+id/btnCreateEvent"
                    android:layout_width="0dp"
                    android:layout_height="85dp"
                    android:layout_columnWeight="1"
                    android:text="➕\nCrear evento"
                    android:textAllCaps="false"
                    android:textSize="17sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#6C3FD1"/>

                <Button
                    android:id="@+id/btnViewEvents"
                    android:layout_width="0dp"
                    android:layout_height="85dp"
                    android:layout_columnWeight="1"
                    android:text="📅\nVer eventos"
                    android:textAllCaps="false"
                    android:textSize="17sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#3A3A3A"/>

                <Button
                    android:id="@+id/btnMyEvents"
                    android:layout_width="0dp"
                    android:layout_height="85dp"
                    android:layout_columnWeight="1"
                    android:text="📝\nMis eventos"
                    android:textAllCaps="false"
                    android:textSize="17sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#3A3A3A"/>

                <Button
                    android:id="@+id/btnHistory"
                    android:layout_width="0dp"
                    android:layout_height="85dp"
                    android:layout_columnWeight="1"
                    android:text="🕘\nHistorial"
                    android:textAllCaps="false"
                    android:textSize="17sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#3A3A3A"/>

            </GridLayout>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#E63946"
                android:layout_marginTop="28dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>